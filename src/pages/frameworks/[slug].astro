---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HYOHCompass from '../../components/HYOHCompass.astro';
import CopyLinkButton from '../../components/CopyLinkButton.astro';
import FloatingLatestNav from '../../components/FloatingLatestNav.astro';
import {
  frameworkDescription,
  frameworkFormLabel,
  frameworkUrl,
  sortFrameworks,
} from '../../utils/frameworks';

export async function getStaticPaths() {
  const frameworks = sortFrameworks(await getCollection('frameworks'));
  return frameworks.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'frameworks'>;
}

const { entry } = Astro.props as Props;
const { Content } = await entry.render();

const allFrameworks = sortFrameworks(await getCollection('frameworks'));
const index = allFrameworks.findIndex((framework) => framework.slug === entry.slug);
const newer = index > 0 ? allFrameworks[index - 1] : null;
const older = index < allFrameworks.length - 1 ? allFrameworks[index + 1] : null;
const canonicalUrl = `https://letters.entr.cc${frameworkUrl(entry)}`;
const description = frameworkDescription(entry);
---

<BaseLayout
  title={`${entry.data.title} — ${entry.data.edition}`}
  description={description}
  canonicalPath={frameworkUrl(entry)}
  type="article"
  author={entry.data.author}
>
  <article class="letter-page framework-page">
    <header class="framework-edition-header">
      <p class="kicker letter-kicker">
        {entry.data.edition} · {entry.data.type} · {frameworkFormLabel(entry)}
      </p>
      <h1>{entry.data.title}</h1>
      <p class="framework-source">Source · {entry.data.source}</p>
      <p class="byline">
        By <a href="https://josephiesue.com" target="_blank" rel="noopener">{entry.data.author}</a> · {entry.data.publication}
      </p>
    </header>

    <hr class="hairline" />

    <div class="letter-body framework-body">
      <Content />
    </div>

    <p class="end-mark">Understand the framework. Carry the practice.</p>

    <div class="post-letter-cta">
      <p>If this edition sharpened your thinking, share it with someone building the same practice — or join the list for future publications.</p>
      <div class="cta-buttons">
        <a class="btn-join" href="/#join">Get future issues</a>
        <CopyLinkButton url={canonicalUrl} />
      </div>
    </div>

    <HYOHCompass variant="cta" />

    <nav class="prev-next">
      {older ? <a href={frameworkUrl(older)}>Previous: {older.data.title}</a> : <span class="empty">Previous</span>}
      {newer ? <a href={frameworkUrl(newer)}>Next: {newer.data.title}</a> : <span class="empty">Next</span>}
    </nav>

    <a class="back-to-archive" href="/frameworks/">Back to Frameworks</a>
  </article>
  <FloatingLatestNav />
</BaseLayout>
