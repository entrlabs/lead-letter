---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import HYOHCompass from '../../components/HYOHCompass.astro';
import {
  codexDescription,
  codexUrl,
  sortCodexEditions,
} from '../../utils/codex';

const allCodexEditions = sortCodexEditions(await getCollection('codex'));
const featured = allCodexEditions[0];
const rest = allCodexEditions.slice(1);
---

<BaseLayout
  title="Codex Editions — The Lead Letter"
  description="Numbered, principle-by-principle studies of the frameworks behind leadership, strategy, management, and resilient work."
>
  <div class="archive-page codex-archive-page">
    <section class="archive-hero codex-archive-hero reveal">
      <p class="kicker">The Lead Letter Codex</p>
      <h1>Codex Editions</h1>
      <p class="archive-count">
        {allCodexEditions.length > 0
          ? `${allCodexEditions.length} edition${allCodexEditions.length === 1 ? '' : 's'} and counting. Occasional deep dives, built to be studied and returned to.`
          : 'Occasional deep dives, built to be studied, shared, and returned to.'}
      </p>
    </section>

    {featured ? (
      <section class="archive-bento codex-bento">
        <a class="archive-card archive-card-featured codex-archive-card reveal" href={codexUrl(featured)}>
          <p class="archive-row-meta">{featured.data.edition} · {featured.data.type} · {featured.data.source}</p>
          <h2 class="archive-row-title">{featured.data.title}</h2>
          <p class="archive-row-desc">{codexDescription(featured)}</p>
        </a>

        {rest.map((entry) => (
          <a class="archive-card codex-archive-card reveal" href={codexUrl(entry)}>
            <p class="archive-row-meta">{entry.data.edition} · {entry.data.type} · {entry.data.source}</p>
            <h2 class="archive-row-title">{entry.data.title}</h2>
            <p class="archive-row-desc">{codexDescription(entry)}</p>
          </a>
        ))}
      </section>
    ) : (
      <section class="codex-archive-empty reveal">
        <p class="codex-eyebrow">The archive is ready</p>
        <h2>The first edition begins with a framework.</h2>
        <p>
          Codex Editions turn one internal or external framework into a numbered set of principles for careful study and off-site use.
        </p>
      </section>
    )}

    <HYOHCompass variant="quiet" />
  </div>
</BaseLayout>
