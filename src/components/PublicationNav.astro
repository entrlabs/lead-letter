---
interface Props {
  latestSignalHref: string;
  latestFieldNoteHref?: string;
  latestFrameworkHref?: string;
}

const {
  latestSignalHref,
  latestFieldNoteHref = '/fieldnotes/',
  latestFrameworkHref = '/frameworks/',
} = Astro.props as Props;

const sections = [
  {
    label: 'Signals Briefs',
    cadence: 'Weekly',
    href: latestSignalHref,
    accent: 'signals',
  },
  {
    label: 'Field Notes',
    cadence: 'Daily',
    href: latestFieldNoteHref,
    accent: 'field-notes',
  },
  {
    label: 'Frameworks',
    cadence: 'Reference',
    href: latestFrameworkHref,
    accent: 'frameworks',
  },
  {
    label: 'Signal Map',
    cadence: 'This week',
    href: '/#latest-signal-map',
    accent: 'signal-map',
    direction: 'down',
  },
] as const;
---

<div class="publication-nav-shell">
  <div class="publication-nav-instruction" id="publication-nav-instruction">
    <strong>Explore The Lead Letter</strong>
    <span>Click below to see the latest in each section.</span>
  </div>

  <nav
    class="publication-nav"
    aria-label="Explore The Lead Letter"
    aria-describedby="publication-nav-instruction"
  >
    {sections.map((section) => (
      <a
        class={`publication-nav-link publication-nav-link--${section.accent}`}
        href={section.href}
      >
        <strong class="publication-nav-label">{section.label}</strong>
        <svg
          class:list={{ 'publication-nav-arrow': true, 'publication-nav-arrow--down': section.direction === 'down' }}
          viewBox="0 0 20 20"
          aria-hidden="true"
        >
          <path d="M4 10h11M11 6l4 4-4 4"></path>
        </svg>
        <span class="publication-nav-cadence">{section.cadence}</span>
      </a>
    ))}
  </nav>
</div>
