---
import { getCollection } from 'astro:content';
import { frameworkUrl, sortFrameworks } from '../utils/frameworks';

const allSignals = (await getCollection('signals')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const allFieldNotes = (await getCollection('fieldnotes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const allFrameworks = sortFrameworks(await getCollection('frameworks'));

const latestSignal = allSignals[0];
const latestFieldNote = allFieldNotes[0];
const latestFramework = allFrameworks[0];

const links = [
  {
    label: 'Signals Brief',
    mobileLabel: 'Signals Brief',
    cadence: 'Weekly',
    href: latestSignal ? `/${latestSignal.data.slug ?? latestSignal.slug}/` : '/archive/',
    accent: 'signals',
  },
  {
    label: 'Field Note',
    mobileLabel: 'Field Notes',
    cadence: 'Daily',
    href: latestFieldNote ? `/fieldnotes/${latestFieldNote.slug}/` : '/fieldnotes/',
    accent: 'field-notes',
  },
  {
    label: 'Framework',
    mobileLabel: 'Frameworks',
    cadence: 'Reference',
    href: latestFramework ? frameworkUrl(latestFramework) : '/frameworks/',
    accent: 'frameworks',
  },
  {
    label: 'Signal Map',
    mobileLabel: 'Signal Map',
    cadence: 'This week',
    href: '/#latest-signal-map',
    accent: 'signal-map',
  },
] as const;
---

<details class="reading-jump">
  <summary>
    <span class="reading-jump-summary-label reading-jump-summary-label--desktop">Read latest</span>
    <span class="reading-jump-summary-label reading-jump-summary-label--mobile">Click to another section</span>
    <svg class="reading-jump-summary-icon" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M5 10h10M10 5v10"></path>
    </svg>
  </summary>

  <div class="reading-jump-panel">
    <div class="reading-jump-heading">
      <strong>Read the latest</strong>
      <span>Choose a section.</span>
    </div>
    <nav aria-label="Read the latest from The Lead Letter">
      {links.map((link) => (
        <a
          class={`reading-jump-link reading-jump-link--${link.accent}`}
          href={link.href}
        >
          <span>
            <small>{link.cadence}</small>
            <strong class="reading-jump-link-label reading-jump-link-label--desktop">{link.label}</strong>
            <strong class="reading-jump-link-label reading-jump-link-label--mobile">{link.mobileLabel}</strong>
          </span>
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h11M11 6l4 4-4 4"></path>
          </svg>
        </a>
      ))}
    </nav>
  </div>
</details>

<script>
  const readingJumpControls = document.querySelectorAll<HTMLDetailsElement>('.reading-jump');
  const mobileReadingJump = window.matchMedia('(max-width: 720px)');

  readingJumpControls.forEach((control) => {
    const article = document.querySelector<HTMLElement>('.letter-page');
    const panel = control.querySelector<HTMLElement>('.reading-jump-panel');
    const summary = control.querySelector<HTMLElement>('summary');
    let previousMode: 'pinned' | 'compact' | 'mobile' | undefined;
    let resizeFrame = 0;

    const updateReadingJumpMode = () => {
      if (!article || !panel || !summary) return;

      const articleRight = article.getBoundingClientRect().right;
      const summaryLeft = summary.getBoundingClientRect().left;
      const panelLeft = summaryLeft - 10 - panel.offsetWidth;
      const hasSideRoom = panelLeft >= articleRight + 24;
      const nextMode = mobileReadingJump.matches
        ? 'mobile'
        : hasSideRoom
          ? 'pinned'
          : 'compact';

      control.classList.toggle('reading-jump--pinned', nextMode === 'pinned');
      control.classList.toggle('reading-jump--compact', nextMode === 'compact');

      if (nextMode !== previousMode) {
        if (nextMode === 'pinned') {
          control.setAttribute('open', '');
        } else {
          control.removeAttribute('open');
        }
      }

      previousMode = nextMode;
    };

    const queueReadingJumpUpdate = () => {
      window.cancelAnimationFrame(resizeFrame);
      resizeFrame = window.requestAnimationFrame(updateReadingJumpMode);
    };

    updateReadingJumpMode();
    window.addEventListener('resize', queueReadingJumpUpdate, { passive: true });
  });

  document.addEventListener('click', (event) => {
    document.querySelectorAll<HTMLDetailsElement>('.reading-jump[open]').forEach((control) => {
      if (
        !control.classList.contains('reading-jump--pinned') &&
        !control.contains(event.target as Node)
      ) {
        control.removeAttribute('open');
      }
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;

    document.querySelectorAll<HTMLDetailsElement>('.reading-jump[open]').forEach((control) => {
      control.removeAttribute('open');
      control.querySelector<HTMLElement>('summary')?.focus();
    });
  });
</script>
