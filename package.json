{
  "name": "lead-letter",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check:weekly-brief": "node scripts/check-weekly-brief.mjs",
    "validate:weekly-brief": "npm run build && npm run check:weekly-brief",
